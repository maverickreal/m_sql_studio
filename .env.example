# ==============================================================================
# SMTP Configuration for Email Verification
# ==============================================================================
# Email verification is required for email/password signup. OAuth is untouched.
# All SMTP_* vars are optional; if unset, the gateway boots and logs a warning,
# skipping sending without crashing.
#
# DEPLOY NOTE: Choose one of the following two options:
#
# Option A: Gmail app-password
#   - SMTP_HOST=smtp.gmail.com
#   - SMTP_PORT=587
#   - SMTP_USER=your-email@gmail.com
#   - SMTP_PASS=<16-character Google App Password>
#   - SMTP_FROM=your-email@gmail.com
#   Setup: Google Account -> Security -> 2-Step Verification -> App passwords.
#   Generate an app password for Mail/Other and set it as SMTP_PASS.
#
# Option B: Resend free tier
#   - SMTP_HOST=smtp.resend.com
#   - SMTP_PORT=465
#   - SMTP_USER=resend
#   - SMTP_PASS=<re_... Resend API Key>
#   - SMTP_FROM=onboarding@resend.dev (or your verified domain address)
#   Setup: Sign up at https://resend.com (free 100 emails/day, 3,000/month).
#   Create an API key with sending permissions and set it as SMTP_PASS.
# ==============================================================================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Hint Stack (ADR 005)
HINT_ENABLED=true
HINT_API_URL=http://127.0.0.1:3208/v1
HINT_MODEL=LFM2.5-8B-A1B-MLX-6bit
HINT_ALLOW_REMOTE=false
HINT_API_KEY=
HINT_REMOTE_API_URL=
HINT_REMOTE_API_KEY=
HINT_REMOTE_MODEL=gemini-3.5-flash
HINT_SAY=false
HINT_CONSENT_PATH=./logs/say-consent.json
HINT_AUDIT_PATH=./logs/hint-audit.jsonl

# mlx-serve command for local LFM2.5:
# mlx_lm.server --model LFM2.5-8B-A1B-MLX-6bit --host 127.0.0.1 --port 3208